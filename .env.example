# LLM providers (one required for dream; OpenAI required for embeddings)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Dream consolidation: which provider/model
ZBRAIN_DREAM_LLM=anthropic              # anthropic | openai | fake
ZBRAIN_DREAM_MODEL=claude-sonnet-4-6

# Embedding provider/model
ZBRAIN_EMBED_PROVIDER=openai            # openai | fake (fake = deterministic, for tests)
ZBRAIN_EMBED_MODEL=text-embedding-3-small

# Install root. Defaults to the repo dir; override to keep pages/ + .zbrain/ elsewhere.
# ZBRAIN_HOME=/Users/you/zbrain-data

# Path to a libsqlite3 with extension loading enabled. Auto-resolves to
# `brew --prefix sqlite`/lib/libsqlite3.dylib; override only if you installed
# sqlite somewhere non-standard.
# ZBRAIN_SQLITE_LIB=/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib

# OpenClaw bridge (optional — if set, file watcher ingests from OpenClaw memory)
# ZBRAIN_OPENCLAW_MEMORY_DIR=/Users/you/.openclaw/workspace/memory

# --- Lineage env vars (INJECTED BY OPENCLAW — do not set for local dev) ---
# The MCP server reads these and merges them into every write's lineage_meta.
# An agent supplying explicit values in its tool call wins over these defaults.
# ZBRAIN_ORCHESTRATOR_SESSION_ID=
# ZBRAIN_PARENT_AGENT_ID=
# ZBRAIN_SPAWN_CHAIN=                   # JSON array string, e.g. ["claw","code-cc-9f3d"]

# LLM providers (one or both required)
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENAI_API_KEY=sk-your-key-here

# Dream consolidation: which provider/model
ZBRAIN_DREAM_LLM=anthropic         # anthropic | openai
ZBRAIN_DREAM_MODEL=claude-sonnet-4-6

# Embedding provider (currently OpenAI only)
ZBRAIN_EMBED_MODEL=text-embedding-3-small

# Internal cron fallback (off by default — OpenClaw cron drives in this deployment)
ZBRAIN_INTERNAL_CRON=false

# OpenClaw bridge (optional — if set, file watcher ingests from OpenClaw memory)
# ZBRAIN_OPENCLAW_MEMORY_DIR=/path/to/.openclaw/workspace

# Optional override for sqlite-vec extension path
# ZBRAIN_VEC_PATH=/explicit/path/to/vec0.dylib

# Lineage env vars (injected by OpenClaw; agents read these to populate lineage_meta)
# These are read by the MCP server, not the agent — safe to leave unset for local dev
# ZBRAIN_ORCHESTRATOR_SESSION_ID=
# ZBRAIN_PARENT_AGENT_ID=
# ZBRAIN_SPAWN_CHAIN=
